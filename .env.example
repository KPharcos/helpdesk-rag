# Copy to .env and adjust. No secrets are committed; .env is git-ignored.

# --- LLM provider: "anthropic" (Claude, paid) or "ollama" (local, free) ---
# Note: docker compose also reads this file, so this value also selects the Docker mode
# (compose defaults to ollama only when LLM_PROVIDER is not set here).
LLM_PROVIDER=anthropic

# Cloud mode (Claude). Leave empty to let the SDK use ANTHROPIC_API_KEY from the shell
# environment or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000

# Local mode (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# Resilience / resource limits (timeout and concurrency cap: both providers;
# retries: Claude SDK only, Ollama is not retried)
# 60 s suits Claude or Ollama on a GPU; use 120 or more for Ollama on a CPU. docker compose reads
# this file too, so the value here also overrides compose's default of 120.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_CONCURRENT_LLM_CALLS=8

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed keeps the model. Default: the system temp dir (cleared on reboot if /tmp is a
# tmpfs), so set a persistent path to avoid downloading again. Docker sets its own.
# EMBEDDING_CACHE_DIR=./.cache/fastembed
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.62

# Paths & lifecycle
DOCS_DIR=data/docs
INDEX_DIR=data/index
INGEST_ON_STARTUP=false

LOG_LEVEL=INFO
